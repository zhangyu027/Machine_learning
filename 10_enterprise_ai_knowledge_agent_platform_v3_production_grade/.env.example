EAK_API_KEY=replace-with-a-long-random-secret
EAK_ENABLE_OLLAMA=false
EAK_OLLAMA_MODEL=llama3.2
EAK_OLLAMA_HOST=http://host.docker.internal:11434
EAK_INDEX_PATH=vector_store/active
EAK_DATABASE_PATH=data/runtime/enterprise_agent.db
EAK_TOP_K=5
EAK_CHUNK_SIZE=800
EAK_CHUNK_OVERLAP=120
EAK_LOG_LEVEL=INFO
